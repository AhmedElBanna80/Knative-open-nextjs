# syntax=docker/dockerfile:1
#
# BUILT-image Trivy scan fixture for examples/bun-exec/Dockerfile.node (#981) —
# NOT a shipped image.
#
# #971's base-image-trivy job scans the pinned node:22-alpine BASE reference;
# #982 made that report-only because the shipped image is patched at build time
# by the Dockerfile's whole-base `apk upgrade --no-cache`, so enforcing on the
# raw base would block main on CVEs the artifact users run has already cleared.
# This fixture reproduces the RUNTIME OS LAYER of Dockerfile.node — the same
# pinned base digest and the same whole-base `apk upgrade` — so the
# supply-chain.yml `built-image-trivy` job can ENFORCE on the PATCHED artifact on
# main: an actionable HIGH surviving the upgrade fails; a base-ref-only CVE the
# upgrade clears does not.
#
# It reproduces only the OS-package layer. The app's pre-compile JS closure is
# scanned by ci.yml's vinext-precompile-closure gate. The FROM digest, the apk
# line and the npm/corepack strip are kept in lockstep with Dockerfile.node by
# tests/built-image-trivy.test.ts (drift guard) and
# tests/base-image-cve-hygiene.test.ts (whole-base upgrade).
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

RUN apk upgrade --no-cache

# Mirror Dockerfile.node's strip of the base-bundled npm + corepack, so this
# enforce-scan sees the SAME patched artifact users run. node:22-alpine's bundled
# npm vendors HIGH/CRITICAL-carrying node_modules (tar, pacote, sigstore, ...) that
# `apk upgrade` cannot touch; the runtime runs `node server.js` and needs no package
# manager, so removing them clears the surface rather than allow-listing it.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
